    "deleteWallet.message2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure you have both your secret recovery phrase and wallet birthday height saved before you proceed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
