          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "^[Aviso:](style: 'boldPrimary') Um slippage ^[inferior a %@%%](style: 'boldPrimary') aumenta a probabilidade de o teu swap não ser concluído e ser reembolsado. Considera usar ^[%@%% ou superior](style: 'boldPrimary'), especialmente para valores maiores."
          }
        }
      }
