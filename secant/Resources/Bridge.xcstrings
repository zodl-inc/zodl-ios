    "bridgeRefusedKeystone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser payments require a Zodl account. Hardware accounts are not supported yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los pagos desde el navegador requieren una cuenta Zodl. Las cuentas de hardware aún no son compatibles."
          }
        }
      }
    },
    "bridgeRefusedMulti": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-recipient payment requests are not supported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de pago con varios destinatarios no son compatibles."
          }
        }
      }
    },
    "bridgeRefusedProposal": {
      "extractionState": "manual",
