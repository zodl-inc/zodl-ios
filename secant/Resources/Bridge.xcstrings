    "bridgeFailureNetwork": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The network submission failed. Check Activity before paying again — the payment may still settle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló el envío a la red. Revisa Actividad antes de pagar de nuevo — el pago aún podría completarse."
          }
        }
      }
    },
