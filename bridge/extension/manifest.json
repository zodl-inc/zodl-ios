{
  "manifest_version": 3,
  "name": "Zodl Bridge (dev)",
  "version": "0.1.0",
  "description": "Hands ZIP-321 payment requests from web pages to the native Zodl app. Holds no keys, no wallet data. One-way by design.",
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": ["nativeMessaging", "notifications"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zodl Bridge"
  }
}
