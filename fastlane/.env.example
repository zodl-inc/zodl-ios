# Copy to fastlane/.env (gitignored) and fill in. Get these from
# App Store Connect → Users and Access → Integrations → App Store Connect API.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
# A bare filename / relative path is resolved against the fastlane/ directory, so
# the simplest setup is to drop the .p8 into fastlane/ and use just its name.
# An absolute path also works.
ASC_KEY_FILEPATH=AuthKey_XXXXXXXXXX.p8
