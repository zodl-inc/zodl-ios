# frozen_string_literal: true

require "open3"
require "fileutils"
require "shellwords"

# require_relative (not fastlane's intercepted `require`) avoids the spurious
# "you have required a gem" notices for our local files. $LOAD_PATH lets these
# files require each other by name; requiring preflight pulls in the other three.
$LOAD_PATH.unshift(File.expand_path("lib", __dir__))
require_relative "lib/zodl/preflight"
require_relative "lib/zodl/build_paths"
require_relative "lib/zodl/notify"
require_relative "lib/zodl/signing"
require_relative "lib/zodl/dmg"
require_relative "lib/zodl/pbxproj"

# Refuse to run outside bundler so the pinned gem versions in Gemfile.lock are
# always used. The Scripts/*.sh wrappers invoke `bundle exec fastlane`.
unless ENV["BUNDLE_GEMFILE"]
  UI.user_error!("Run through bundler: use ./Scripts/release.sh or ./Scripts/bump.sh (they call `bundle exec fastlane`).")
end

PROJECT = Zodl::BuildPaths::PROJECT
TEST_SCHEME = "zodl-internal"        # only scheme wired to the zodlTests target
TEST_DEVICE = "iPhone 17 Pro"
PARTNER_KEYS_REL = "secant/Resources/PartnerKeys.plist"
FASTLANE_DIR = __dir__
TEAM_ID = "RLPRR8CPQG"               # Apple Developer team (matches DEVELOPMENT_TEAM in the project)

# Swift macros (TCA, swift-dependencies, swift-perception, swift-case-paths) and
# SPM build-tool plugins (SwiftGen, SwiftLint, XCStringsTool) must be trusted
# before use. A fresh build worktree carries no prior approval and this
# non-interactive CLI build (fastlane → xcodebuild) can't show the trust prompt,
# so without these flags xcodebuild fails at ComputeTargetDependencyGraph with
# "Macro … must be enabled before it can be used". Both the test run and the
# archive go through the same xcodebuild CLI, so both need them — keep the flags
# here so the two invocations can't drift apart.
SKIP_VALIDATION_XCARGS = "-skipPackagePluginValidation -skipMacroValidation"

# Render xcodebuild output with xcbeautify rather than xcpretty. Most of this app's
# tests are Swift Testing (@Test / #expect); xcpretty predates that format and
# silently swallows its output, so a failing Swift Testing test would scroll past
# with nothing printed. fastlane only auto-selects xcbeautify when it's installed
# (otherwise it falls back to xcpretty), so pin it here and treat it as a build
# prerequisite: `brew install xcbeautify`.
XCODEBUILD_FORMATTER = "xcbeautify"

# Don't auto-generate fastlane/README.md on every run; it is maintained by hand.
skip_docs

desc "Build, sign, and upload one or more variants. Driven by Scripts/release.sh."
lane :release do |options|
  repo_root = run("git rev-parse --show-toplevel", must_succeed: true).strip
  ref       = options.fetch(:ref)
  version   = options.fetch(:version)
  build     = Integer(options.fetch(:build))
  dry_run   = truthy(options[:dry_run])

  variants = Zodl::Variants.expand(options.fetch(:variant))
  # Context for the `error` hook below, which only receives the raised exception.
  @notify_context = { variants: variants, version: version, build: build }

  UI.message("Fetching latest refs from origin…")
  # Fail closed: the preflight reconciles against origin, so a failed fetch must abort
  # rather than silently leave the checks running on stale local refs.
  run("git -C #{repo_root.shellescape} fetch --quiet --tags origin", must_succeed: true)
  sha = resolve_sha(repo_root, ref)
  branch_version = Zodl::Version.from_branch(ref)
  pbxproj = pbxproj_at(repo_root, sha)

  installed_identities = run("security find-identity -v -p codesigning")
  sdk = sdk_facts(repo_root)

  app_names = {}
  variants.each do |variant|
    cfg = Zodl::Variants.config(variant)
    if cfg[:platform] == :macos
      app_names[variant] = begin
        Zodl::Pbxproj.product_name(pbxproj, target: cfg[:target])
      rescue ArgumentError => e
        UI.user_error!(e.message)
      end
      UI.user_error!("PRODUCT_NAME not found for target '#{cfg[:target]}' at #{sha[0, 8]}") if app_names[variant].nil?
    end
    UI.message("Reconciling #{variant} against git, the project, and App Store Connect…")
    ctx = Zodl::Preflight::Context.new(
      variant: variant,
      requested_version: version,
      requested_build: build,
      project_version: marketing_version_for(pbxproj, cfg[:target]),
      branch_version: branch_version,
      latest_build: cfg[:channel] == :dmg ? nil : latest_build_number(cfg[:app_identifier], version, cfg[:platform]),
      ref_on_origin: ref_on_origin?(repo_root, sha),
      dirty_tree: dirty_tree?(repo_root),
      partner_keys_error: partner_keys_error(repo_root),
      xcode_ok: xcode_ok?(repo_root),
      missing_signing_identities: Zodl::Signing.missing_identities(
        platform: cfg[:platform], channel: cfg[:channel], installed: installed_identities
      ),
      sdk_checkout_ok: sdk[:checkout_ok],
      ffi_slice_ok: ffi_slice_ok?(sdk, cfg[:platform]),
      sdk_dirty: sdk[:dirty]
    )
    report = Zodl::Preflight.check(ctx)
    print_summary(variant, cfg, ref, sha, ctx, report, sdk, app_names[variant])
    UI.user_error!("Preflight failed for #{variant} — aborting.") unless report.ok?
  end

  if dry_run
    Zodl::Notify.post(event: :dry_run_ok, variants: variants, version: version, build: build)
    UI.success("Dry run complete — preflight passed for: #{variants.join(', ')}. No build performed.")
    next
  end

  UI.user_error!("Aborted.") unless truthy(options[:yes]) || UI.confirm("Proceed with the build above?")

  # Resolve+verify the signing key path now (cwd is still the real repo), so it's
  # an absolute path into the real fastlane dir before we chdir into the worktree.
  auth_xcargs = asc_auth_xcargs(repo_root)

  # Create/refresh the App Store distribution profiles up front, so a signing or
  # API-permission problem fails now instead of after the ~15-minute build.
  ensure_profiles(variants)

  # sigh stashes every minted profile in the lane context, and build_app merges
  # those into export_options by bundle id — clobbering the explicit per-channel
  # provisioningProfiles map. Both mac profiles share one bundle id, so the merge
  # would make the App Store export reference the Developer ID profile. The
  # explicit maps below are the single source of truth; drop sigh's context.
  lane_context.delete(SharedValues::SIGH_PROFILE_PATHS)
  lane_context.delete(SharedValues::SIGH_PROFILE_PATH)
  lane_context.delete(SharedValues::SIGH_PROFILE_TYPE)

  # A sibling of the repo (NOT $TMPDIR): the project references the local SDK
  # package at ../ZcashLightClientKit, which must resolve from inside the
  # worktree too.
  worktree = File.join(File.dirname(repo_root), "zodl-release-#{sha[0, 8]}")
  outcomes = []
  begin
    UI.message("Creating a clean build worktree at #{sha[0, 8]}…")
    run("git -C #{repo_root.shellescape} worktree add --detach #{worktree.shellescape} #{sha}", must_succeed: true)
    FileUtils.cp(File.join(repo_root, PARTNER_KEYS_REL), File.join(worktree, PARTNER_KEYS_REL))

    Dir.chdir(worktree) do
      # Absolute paths, anchored to the worktree: fastlane runs each action inside
      # `Dir.chdir("..")`, which from here lands in the worktree's PARENT, so any
      # RELATIVE path passed to run_tests/build_app would resolve there and break.
      paths = Zodl::BuildPaths.resolve(worktree)
      UI.message("Resolving Swift packages…")
      run("xcodebuild -project #{PROJECT} -scheme #{TEST_SCHEME} -resolvePackageDependencies", must_succeed: true)
      run_unit_tests(paths) unless truthy(options[:skip_tests])
      variants.each do |variant|
        UI.message("Building #{variant}…")
        outcomes << build_and_upload(variant, version, build, paths, auth_xcargs, repo_root, app_names[variant])
      end
    end
  ensure
    if File.directory?(worktree)
      UI.message("Cleaning up the build worktree…")
      run("git -C #{repo_root.shellescape} worktree remove --force #{worktree.shellescape}")
    end
  end

  Zodl::Notify.post(event: :success, variants: variants, version: version, build: build, outcomes: outcomes)
  UI.success("Done: #{outcomes.join('; ')} — #{version} (#{build}) from #{ref} @ #{sha[0, 8]}")
end

desc "Set MARKETING_VERSION and CURRENT_PROJECT_VERSION for a target scope and commit. Driven by Scripts/bump.sh."
lane :bump do |options|
  version = options.fetch(:version)
  build   = Integer(options.fetch(:build))
  selector = options[:target].to_s
  UI.user_error!("target is required — an Xcode target name, 'ios' (all iOS app targets), 'mac' (all macOS app targets), or 'all'") if selector.empty?
  UI.user_error!("version '#{version}' is not in X.Y.Z form") unless Zodl::Version.valid?(version)
  targets = begin
    Zodl::Variants.bump_targets(selector)
  rescue ArgumentError => e
    UI.user_error!(e.message)
  end
  repo_root = run("git rev-parse --show-toplevel", must_succeed: true).strip

  Dir.chdir(repo_root) do
    UI.message("Setting #{targets.join(', ')} to #{version} (#{build})…")
    set_versions(targets, version, build)
    UI.message("Committing the version bump…")
    run("git add secant.xcodeproj/project.pbxproj", must_succeed: true)
    run("git commit -m #{"Bump #{selector} to #{version} (#{build})".shellescape}", must_succeed: true)
  end

  UI.success("Bumped #{selector} to #{version} (#{build}) and committed.")
end

# Notify on a failed release. The success and dry-run paths post inline (where
# the full context is in scope); this hook catches every other abort/exception.
# Posting is failure-safe and never changes the exit status — fastlane still
# re-raises after this block. `bump` is intentionally not covered.
error do |lane, exception|
  next unless lane.to_s == "release"
  # A declined confirmation prompt is a deliberate user stop, not a failure.
  next if exception.message.to_s.start_with?("Aborted")

  context = @notify_context || {}
  Zodl::Notify.post(
    event: :failure,
    variants: context[:variants] || [],
    version: context[:version],
    build: context[:build],
    reason: exception.message
  )
end

# --- helpers -------------------------------------------------------------

# Runs a shell command WITHOUT creating a fastlane "shell command" step (those
# are unlabelled and noisy). Returns captured stdout. With must_succeed:, a
# non-zero exit aborts the lane with the command's stderr.
def run(command, must_succeed: false)
  stdout, stderr, status = Open3.capture3("/bin/sh", "-c", command)
  if must_succeed && !status.success?
    UI.user_error!("Command failed (exit #{status.exitstatus}): #{command}\n#{stderr.strip}")
  end
  stdout
end

# Like `run`, but argv form (no shell) with must-succeed semantics and an
# optional retry for flaky external tools (hdiutil under create-dmg).
def run_argv(argv, retries: 0)
  attempts = 0
  begin
    attempts += 1
    stdout, stderr, status = Open3.capture3(*argv)
    unless status.success?
      raise "#{argv.first} failed (exit #{status.exitstatus}): #{stderr.strip.empty? ? stdout.strip : stderr.strip}"
    end
    stdout
  rescue RuntimeError, SystemCallError => e
    retry if attempts <= retries
    UI.user_error!(e.message)
  end
end

def truthy(value)
  ["1", "true", "yes", true].include?(value)
end

def asc_api_key
  # A relative ASC_KEY_FILEPATH is resolved against fastlane/, so a developer can
  # drop the .p8 in fastlane/ and reference it by filename. Absolute paths work too.
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: File.expand_path(ENV.fetch("ASC_KEY_FILEPATH"), FASTLANE_DIR)
  )
end

# Lazily fetched so flows that never touch App Store Connect (a DMG-channel
# --dry-run has no TestFlight train to query) work without ASC credentials.
def api_key
  @api_key ||= asc_api_key
end

# xcodebuild flags that authenticate automatic signing (-allowProvisioningUpdates)
# with the App Store Connect API key. gym/build_app has no api_key option, so
# without these the export step can't reach App Store Connect to create the
# distribution profile the entitlements need (Associated Domains, iCloud) and
# falls back to Xcode's stored GUI accounts — failing on a stale one. Same key as
# asc_api_key. The path is anchored on the absolute repo_root (NOT the cwd-relative
# FASTLANE_DIR): build_app runs inside Dir.chdir(worktree), so FASTLANE_DIR would
# resolve into the worktree — which has no .p8 — and xcodebuild would reject the
# path as non-existent. Checked here so we fail fast, not minutes into the build.
def asc_auth_xcargs(repo_root)
  key_path = File.expand_path(ENV.fetch("ASC_KEY_FILEPATH"), File.join(repo_root, "fastlane"))
  UI.user_error!("ASC API key not found at #{key_path} — set ASC_KEY_FILEPATH in fastlane/.env") unless File.exist?(key_path)
  [
    "-authenticationKeyPath #{key_path.shellescape}",
    "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID').shellescape}",
    "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID').shellescape}"
  ].join(" ")
end

# Latest build number for an app+version on App Store Connect (TestFlight train).
# initial_build_number: 0 makes the action return 0 (not raise) when there is no
# build yet for this version, so any exception below is a genuine failure.
def latest_build_number(app_identifier, version, platform)
  app_store_build_number(
    api_key: api_key,
    app_identifier: app_identifier,
    platform: platform == :macos ? "osx" : "ios",
    version: version,
    live: false,
    initial_build_number: 0
  )
rescue StandardError => e
  # Fail closed: treating an auth/network/API failure as "latest = 0" would let
  # any requested build number pass the preflight build-number check and upload a
  # duplicate or regressing build. Abort instead so the developer can retry.
  UI.user_error!("Could not fetch the latest build number for #{app_identifier} #{version} from App Store Connect (#{e.message}). Re-run once App Store Connect is reachable.")
end

# The project file as committed at `sha` — the version source of truth for the
# ref being built (NOT the current checkout).
def pbxproj_at(repo_root, sha)
  run("git -C #{repo_root.shellescape} show #{sha}:#{Zodl::BuildPaths::PROJECT}/project.pbxproj", must_succeed: true)
end

# MARKETING_VERSION of the variant's own target. Targets are versioned
# independently (the macOS app does not track the iOS version), so the check
# must read the target this variant actually builds — never a whole-file first
# match. nil (target/setting not found) skips the preflight version check.
def marketing_version_for(pbxproj, target)
  versions = Zodl::Pbxproj.marketing_versions(pbxproj, target: target)
  if versions.size > 1
    UI.user_error!("target '#{target}' configurations disagree on MARKETING_VERSION (#{versions.join(', ')}) — align them in the project")
  end
  versions.first
end

# Rewrites MARKETING_VERSION and CURRENT_PROJECT_VERSION inside each named
# target's own configuration blocks. agvtool has no per-target mode, and every
# Info.plist references these build settings, so pbxproj surgery is the whole
# job. Targets not named keep their versions — macOS is versioned independently
# of iOS.
def set_versions(targets, version, build)
  path = "#{Zodl::BuildPaths::PROJECT}/project.pbxproj"
  text = File.read(path)
  targets.each do |target|
    text = Zodl::Pbxproj.set_setting(text, target: target, key: "MARKETING_VERSION", value: version)
    text = Zodl::Pbxproj.set_setting(text, target: target, key: "CURRENT_PROJECT_VERSION", value: build.to_s)
  end
  File.write(path, text)
end

# Resolves a branch/tag/commit to a commit SHA. Prefers origin/<ref> so a release
# built from a branch name uses the freshly-fetched origin tip, not a possibly-stale
# local branch of the same name; falls back to the bare ref, which is what resolves
# tags and commit SHAs (origin/<tag> and origin/<sha> don't exist).
def resolve_sha(repo_root, ref)
  ["origin/#{ref}", "#{ref}"].each do |candidate|
    out = run("git -C #{repo_root.shellescape} rev-parse --verify --quiet #{candidate.shellescape}^{commit}").strip
    return out unless out.empty?
  end
  UI.user_error!("Could not resolve ref '#{ref}' (tried 'origin/#{ref}' and '#{ref}'). Fetch or push it first.")
end

def ref_on_origin?(repo_root, sha)
  # branch -r --contains lists only remote-tracking branches, never tags. A
  # release built from a tag whose commit isn't on a remote branch is still on
  # origin if the tag is pushed, so also match the sha against origin's tags
  # (ls-remote prints the tagged commit on the ^{} line for annotated tags).
  on_branch = !run("git -C #{repo_root.shellescape} branch -r --contains #{sha} 2>/dev/null").strip.empty?
  return true if on_branch

  run("git -C #{repo_root.shellescape} ls-remote --tags origin 2>/dev/null").lines.any? do |line|
    line.split(/\s+/).first == sha
  end
end

def dirty_tree?(repo_root)
  !run("git -C #{repo_root.shellescape} status --porcelain").strip.empty?
end

# Runs the archive-time PartnerKeys validator and returns nil when it passes, or
# the validator's specific complaint (e.g. "PartnerKeys.plist: missing key 'x'").
def partner_keys_error(repo_root)
  script = File.join(repo_root, "Scripts/validate-partner-keys.sh")
  stdout, _stderr, status = Open3.capture3({ "ACTION" => "install", "SRCROOT" => repo_root }, "bash", script)
  return nil if status.success?

  detail = stdout.lines.map(&:strip).find { |l| l.start_with?("error:") }
  detail ? detail.sub(/^error:\s*/, "") : "PartnerKeys.plist is missing or invalid"
end

def xcode_ok?(repo_root)
  pinned = File.read(File.join(repo_root, ".xcode-version")).strip
  current = run("xcodebuild -version")[/Xcode (\S+)/, 1]
  current == pinned
rescue StandardError
  false
end

# Facts about the sibling ZcashLightClientKit checkout this branch builds
# against (local Swift package reference ../ZcashLightClientKit).
def sdk_facts(repo_root)
  path = File.expand_path("../ZcashLightClientKit", repo_root)
  checkout_ok = File.directory?(path)
  {
    path: path,
    checkout_ok: checkout_ok,
    sha: checkout_ok ? run("git -C #{path.shellescape} rev-parse --short HEAD").strip : nil,
    dirty: checkout_ok && !run("git -C #{path.shellescape} status --porcelain").strip.empty?
  }
end

# The local FFI must carry the slice the variant links against. Folder names
# and the xcframework Info.plist have both been caught claiming architectures
# the binary doesn't contain, so for macOS we lipo the actual binary: a mac
# Release archive links arm64 AND x86_64.
def ffi_slice_ok?(sdk, platform)
  return false unless sdk[:checkout_ok]

  xcframework = File.join(sdk[:path], "LocalPackages/libzcashlc.xcframework")
  case platform
  when :macos
    binary = Dir[File.join(xcframework, "macos-*", "libzcashlc.framework", "libzcashlc")].first
    return false unless binary

    archs = run("lipo -archs #{binary.shellescape} 2>/dev/null").split
    %w[arm64 x86_64].all? { |arch| archs.include?(arch) }
  else
    File.directory?(File.join(xcframework, "ios-arm64"))
  end
end

def run_unit_tests(paths)
  run_tests(
    project: paths[:project],
    scheme: TEST_SCHEME,
    devices: [TEST_DEVICE],
    only_testing: ["zodlTests"],
    derived_data_path: paths[:derived_data],
    code_coverage: false,
    clean: false,
    xcodebuild_formatter: XCODEBUILD_FORMATTER,
    # Emit no scan reports. Nothing consumes them (CI runs tests on its own
    # xcresult path, and the release lane never reads them), and HTML reports
    # require xcpretty — which we intentionally don't use — so scan's default
    # "html,junit" makes xcbeautify warn about the unsupported 'html' type.
    # Pass/fail comes from the test run itself, not from these files.
    output_types: "",
    xcargs: "CODE_SIGNING_ALLOWED=NO #{SKIP_VALIDATION_XCARGS}"
  )
end

# App Store distribution profile name per variant. Used both to create the profile
# (get_provisioning_profile) and to reference it in gym's export options.
def appstore_profile_name(variant)
  "ZODL #{variant} App Store"
end

# Developer ID profiles are per-variant — the DMG flavors sign different
# bundle ids and cannot share a profile.
def developer_id_profile_name(variant)
  "ZODL #{variant} Developer ID"
end

# Create/refresh the distribution profile each variant exports with, so a
# signing or API-permission problem fails now instead of after the ~15-minute
# build. force: true regenerates so the profile always carries the App ID's
# current capabilities (Associated Domains, iCloud).
def ensure_profiles(variants)
  variants.each do |variant|
    cfg = Zodl::Variants.config(variant)
    sigh_platform = cfg[:platform] == :macos ? "macos" : "ios"
    if cfg[:channel] == :dmg
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: cfg[:app_identifier],
        provisioning_name: developer_id_profile_name(variant),
        platform: sigh_platform,
        developer_id: true,
        force: true
      )
    else
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: cfg[:app_identifier],
        provisioning_name: appstore_profile_name(variant),
        platform: sigh_platform,
        force: true
      )
    end
  end
end

# Run a block with Apple's /usr/bin ahead of everything else in PATH, then restore
# it. Xcode's exportArchive copies the app into the .ipa with
# `/usr/bin/rsync -8aPhhE` — Apple's rsync, where -E means --extended-attributes.
# For a local copy rsync forks a helper ("server") child resolved via $PATH by bare
# name; a Homebrew rsync 3.x earlier in PATH (there -E is --executability and
# --extended-attributes is unknown) rejects the option, so the export dies with
# "Copy failed" / "rsync error: syntax or usage error … [server=3.x]". Pinning
# /usr/bin first makes both ends Apple's rsync, so the build works whether or not a
# Homebrew rsync is installed. Safe here because the fastlane Ruby is already
# running (via rbenv's bundler); this only changes PATH for child processes (gym →
# xcodebuild) spawned inside the block, and the caller's PATH is restored after.
def with_system_rsync_first
  previous_path = ENV["PATH"]
  ENV["PATH"] = "/usr/bin:#{previous_path}"
  yield
ensure
  ENV["PATH"] = previous_path
end

def build_and_upload(variant, version, build, paths, auth_xcargs, repo_root, app_name)
  cfg = Zodl::Variants.config(variant)
  if cfg[:platform] == :macos
    return mac_dmg(variant, cfg, version, build, paths, auth_xcargs, repo_root, app_name) if cfg[:channel] == :dmg

    mac_testflight(variant, cfg, version, build, paths, auth_xcargs)
  else
    ios_testflight(variant, cfg, version, build, paths, auth_xcargs)
  end
end

def ios_testflight(variant, cfg, version, build, paths, auth_xcargs)
  ipa = with_system_rsync_first do
    build_app(
      project: paths[:project],
      scheme: cfg[:scheme],
      configuration: cfg[:configuration],
      export_method: "app-store",
      output_directory: paths[:output_dir],
      output_name: "#{variant}-#{version}-#{build}.ipa",
      clean: true,
      derived_data_path: paths[:derived_data],
      xcodebuild_formatter: XCODEBUILD_FORMATTER,
      xcargs: "CURRENT_PROJECT_VERSION=#{build} -allowProvisioningUpdates #{auth_xcargs} #{SKIP_VALIDATION_XCARGS}",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        provisioningProfiles: { cfg[:app_identifier] => appstore_profile_name(variant) }
      }
    )
  end

  upload_to_testflight(
    api_key: api_key,
    app_identifier: cfg[:app_identifier],
    ipa: ipa,
    skip_submission: true,
    distribute_external: false,
    skip_waiting_for_build_processing: false # wait for App Store Connect processing
  )

  UI.success("Uploaded #{cfg[:app_identifier]} #{version} (#{build}) to TestFlight.")
  "#{variant} → TestFlight"
end

def mac_testflight(variant, cfg, version, build, paths, auth_xcargs)
  # gym/build_app strips only a trailing ".ipa" from output_name and appends
  # ".pkg" itself for a macOS package export, so an output_name that already
  # ends in ".pkg" comes out "….pkg.pkg". Pass an extension-less base name.
  pkg_base = "#{variant}-#{version}-#{build}"
  with_system_rsync_first do
    build_app(
      project: paths[:project],
      scheme: cfg[:scheme],
      configuration: cfg[:configuration],
      export_method: "app-store",
      destination: "generic/platform=macOS",
      output_directory: paths[:output_dir],
      output_name: pkg_base,
      clean: true,
      derived_data_path: paths[:derived_data],
      xcodebuild_formatter: XCODEBUILD_FORMATTER,
      xcargs: "CURRENT_PROJECT_VERSION=#{build} -allowProvisioningUpdates #{auth_xcargs} #{SKIP_VALIDATION_XCARGS}",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        signingCertificate: "Apple Distribution",
        installerSigningCertificate: "Mac Installer Distribution",
        provisioningProfiles: { cfg[:app_identifier] => appstore_profile_name(variant) }
      }
    )
  end
  pkg = File.join(paths[:output_dir], "#{pkg_base}.pkg")
  UI.user_error!("expected the exported package at #{pkg}") unless File.exist?(pkg)

  upload_to_testflight(
    api_key: api_key,
    app_identifier: cfg[:app_identifier],
    pkg: pkg,
    app_platform: "osx",
    skip_submission: true,
    distribute_external: false,
    skip_waiting_for_build_processing: false
  )
  UI.success("Uploaded #{cfg[:app_identifier]} #{version} (#{build}) [macOS] to TestFlight.")
  "#{variant} → TestFlight"
end

def mac_dmg(variant, cfg, version, build, paths, auth_xcargs, repo_root, app_name)
  with_system_rsync_first do
    build_app(
      project: paths[:project],
      scheme: cfg[:scheme],
      configuration: cfg[:configuration],
      export_method: "developer-id",
      destination: "generic/platform=macOS",
      output_directory: paths[:output_dir],
      clean: true,
      derived_data_path: paths[:derived_data],
      xcodebuild_formatter: XCODEBUILD_FORMATTER,
      xcargs: "CURRENT_PROJECT_VERSION=#{build} -allowProvisioningUpdates #{auth_xcargs} #{SKIP_VALIDATION_XCARGS}",
      export_options: {
        signingStyle: "manual",
        teamID: TEAM_ID,
        signingCertificate: "Developer ID Application",
        provisioningProfiles: { cfg[:app_identifier] => developer_id_profile_name(variant) }
      }
    )
  end
  bundle_name = "#{app_name}.app"
  app = File.join(paths[:output_dir], bundle_name)
  UI.user_error!("expected the exported app at #{app}") unless File.directory?(app)

  UI.message("Notarizing #{bundle_name}…")
  notarize(package: app, bundle_id: cfg[:app_identifier], api_key: api_key, print_log: true)

  # create-dmg images the whole source folder, so stage a folder holding only
  # the app. ditto (not cp) preserves the code signature and extended attrs.
  staging = File.join(paths[:output_dir], "dmg-staging")
  FileUtils.rm_rf(staging)
  FileUtils.mkdir_p(staging)
  run("ditto #{app.shellescape} #{File.join(staging, bundle_name).shellescape}", must_succeed: true)

  dmg = File.join(paths[:output_dir], Zodl::Dmg.filename(flavor: cfg[:flavor], version: version, build: build))
  FileUtils.rm_f(dmg)
  icns = Dir[File.join(app, "Contents", "Resources", "*.icns")].sort
  volicon = icns.find { |path| File.basename(path) == "AppIcon.icns" } || icns.first
  # Window background with the app→Applications arrow baked in (HiDPI TIFF,
  # regenerable via fastlane/assets/render-dmg-background.swift). Resolved from
  # the worktree (paths[:output_dir] is <worktree>/build) so the built ref's own
  # asset is used; skipped gracefully if the ref predates it.
  background = File.join(File.dirname(paths[:output_dir]), "fastlane", "assets", "dmg-background.tiff")
  run_argv(
    Zodl::Dmg.create_dmg_command(
      app_name: bundle_name, source_dir: staging, dmg_path: dmg, volname: app_name,
      volicon: volicon, background: File.exist?(background) ? background : nil
    ),
    retries: 1 # hdiutil occasionally fails with "Resource busy"; one retry clears it
  )
  run_argv(Zodl::Dmg.codesign_command(path: dmg))

  UI.message("Notarizing the DMG…")
  notarize(package: dmg, bundle_id: cfg[:app_identifier], api_key: api_key, print_log: true)

  final_dir = File.join(repo_root, "build")
  FileUtils.mkdir_p(final_dir)
  final = File.join(final_dir, File.basename(dmg))
  FileUtils.cp(dmg, final)
  UI.success("DMG ready: #{final}")
  "#{variant} → DMG at #{final}"
end

def print_summary(variant, cfg, ref, sha, ctx, report, sdk, app_name)
  UI.message("──────── preflight: #{variant} ────────")
  UI.message("  scheme/target  #{cfg[:scheme]} / #{cfg[:target]} (#{cfg[:configuration]})")
  UI.message("  app            #{cfg[:app_identifier]}")
  UI.message("  channel        #{cfg[:channel]} (#{cfg[:platform]})")
  UI.message("  app name       #{app_name}.app") if app_name
  UI.message("  sdk            ../ZcashLightClientKit @ #{sdk[:sha] || 'MISSING'}#{sdk[:dirty] ? ' (dirty)' : ''}")
  UI.message("  ref            #{ref} @ #{sha[0, 8]}")
  UI.message("  version        #{ctx.requested_version} (project #{ctx.project_version})")
  latest = ctx.latest_build.nil? ? "n/a (no ASC train)" : ctx.latest_build
  UI.message("  build          #{ctx.requested_build} (latest on ASC #{latest})")
  report.warnings.each { |w| UI.important("  warning: #{w}") }
  report.errors.each { |e| UI.error("  error:   #{e}") }
end
